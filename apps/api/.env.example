DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000

# Vercel Blob (avatar uploads) — create a store with `vercel blob create-store` and
# copy the token from Vercel > Storage > your store > .env.local
BLOB_READ_WRITE_TOKEN=

FOOTBALL_API_PROVIDER=mock

FOOTBALL_DATA_API_KEY=
THESPORTSDB_API_KEY=

# Background match sync. Runs inside the API process on boot and every N minutes;
# it no-ops while FOOTBALL_API_PROVIDER=mock.
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=10
# Optional: lets an external cron POST /sync/matches with `x-sync-secret: <value>`.
# Without it, that route requires an admin session.
SYNC_SECRET=

# Optional: without these, forgot-password returns the reset token directly in the
# API response (dev mode) instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Tribuna <no-reply@tribuna.app>
