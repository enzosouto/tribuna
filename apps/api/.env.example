DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000

FOOTBALL_API_PROVIDER=mock

FOOTBALL_DATA_API_KEY=
THESPORTSDB_API_KEY=

# Optional: without these, forgot-password returns the reset token directly in the
# API response (dev mode) instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Tribuna <no-reply@tribuna.app>
